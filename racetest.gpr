--
--  The checks without a window: races on every track, and replays
with "gtkada";

project Racetest is
   for Source_Dirs use ("src", "tests");
   for Source_Files use ("geom.ads", "geom.adb", "tracks.ads", "tracks.adb", "cars.ads", "cars.adb",
                         "race.ads", "race.adb", "terrain.ads", "terrain.adb", "racetest.adb");
   for Object_Dir use "obj/test";
   for Exec_Dir use "bin";
   for Main use ("racetest.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2012", "-gnatwa", "-gnatyN", "-gnatwU", "-gnata");
   end Compiler;
end Racetest;
